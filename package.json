{
  "name": "batch-cluster",
  "version": "19.0.0",
  "description": "Manage a cluster of child processes",
  "main": "dist/BatchCluster.js",
  "homepage": "https://photostructure.github.io/batch-cluster.js/",
  "bugs": {
    "url": "https://github.com/photostructure/batch-cluster.js/issues"
  },
  "types": "dist/BatchCluster.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/batch-cluster.js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/test.*",
    "!dist/test-helpers.*",
    "!dist/*-helper.*",
    "!dist/find-flush-thresholds.*",
    "!dist/FlushThresholdTestHelpers.*",
    "!dist/TestEnv.*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ci": "npm ci",
    "clean": "rimraf dist .cache",
    "fmt": "run-p fmt:*",
    "fmt:pkg": "npm pkg fix",
    "fmt:prettier": "prettier --write .",
    "lint": "eslint src",
    "compile": "rimraf dist && tsc && node -e \"require('fs').copyFileSync('src/test.js','dist/test.js')\"",
    "check:package": "node scripts/check-package.mjs",
    "check:npm-version": "node scripts/check-npm-version.mjs",
    "watch": "rimraf dist && tsc --watch",
    "test": "run-s clean lint compile check:package test:mocha",
    "test:mocha": "mocha dist/**/*.spec.js",
    "docs": "run-s docs:*",
    "docs:build": "typedoc",
    "docs:serve": "cp .serve.json build/docs/serve.json && touch build/docs/.nojekyll && serve build/docs",
    "update": "run-p update:*",
    "update:deps": "npm run check:npm-version && npm-check-updates --upgrade --install always",
    "install:pinact": "go install github.com/suzuki-shunsuke/pinact/v4/cmd/pinact@v4.1.0",
    "update:actions": "command -v pinact > /dev/null 2>&1 && pinact run -u || echo 'Skipping pinact (not installed)'",
    "find-flush-thresholds": "npm run compile && node dist/find-flush-thresholds.js",
    "all": "npm run check:npm-version && npm install && run-s update fmt docs:build test"
  },
  "author": "Matthew McEachen <matthew-batchcluster@photostructure.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7",
    "@types/chai-string": "^1.4.5",
    "@types/chai-subset": "^1.3.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.2",
    "chai-string": "^1.6.0",
    "chai-subset": "^1.6.0",
    "chai-withintoleranceof": "^1.0.1",
    "eslint": "^9.27.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.8.0",
    "mocha": "^11.7.6",
    "npm-check-updates": "^23.0.0",
    "npm-run-all2": "9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^5.0.10",
    "seedrandom": "^3.0.5",
    "serve": "^14.2.6",
    "source-map-support": "^0.5.21",
    "split2": "^4.2.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
